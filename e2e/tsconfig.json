{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "es2022",
        "lib": ["esnext", "dom"],
        "types": ["node"],
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "results"]
}
